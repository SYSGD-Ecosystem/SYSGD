# Database (PostgreSQL - misma de Railway)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sysgd
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT - MISMO valor que el servidor Node
JWT_SECRET=your_jwt_secret_here

# Clave de cifrado del registro TCP (32 caracteres)
LEDGER_ENCRYPTION_KEY=your_32_char_encryption_key

# App
APP_URL=http://localhost:8000
APP_ENV=production
