{
  "name": "electron",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Documentos - Aplicación de escritorio",
  "main": "main.js",
  "homepage": "https://github.com/unisofthub/SYSGD",
  "scripts": {
    "dev": "electron main.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "keywords": ["electron", "desktop", "documents", "management", "sysgd"],
  "author": {
    "name": "SYSGD Team",
    "email": "team@unisofthub.com"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.unisofthub.sysgd",
    "productName": "SYSGD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*",
      "www/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "category": "Office",
      "maintainer": "SYSGD <support@ecosysgd.com>"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SYSGD"
    }
  }
}
